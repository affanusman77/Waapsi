# Frontend (safe to expose: anon key is protected by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (edge function secrets / local scripts). NEVER commit values.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_USER_PASSWORD=
AI_BASE_URL=            # e.g. https://api.groq.com/openai/v1
AI_API_KEY=
AI_STT_MODEL=whisper-large-v3
AI_LLM_MODEL=
AI_VISION_MODEL=
TTS_PROVIDER=browser    # openai | google | browser
TTS_API_KEY=
DEMO_MODE=true          # demo OTP, time scaling, seed data
DEMO_TIME_SCALE=60      # 60 = 1 real minute counts as 1 hour (escalation demo)
META_WA_TOKEN=          # WhatsApp alerts (F3), preferred: Meta WhatsApp Cloud API access token
META_WA_PHONE_ID=       # Meta test/business phone number ID
TWILIO_ACCOUNT_SID=     # alternative provider; none set = simulated (audit log only)
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox number
REKOGNITION_ACCESS_KEY_ID=   # face check on suggested matches (F4); empty = off
REKOGNITION_SECRET_ACCESS_KEY=
REKOGNITION_REGION=ap-southeast-2
